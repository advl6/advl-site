{
  // Cloudflare Worker that serves the static site in ./public.
  // worker.js only handles /img/og/card.jpg (a random business card for link previews); all other requests are plain static files.
  "name": "advl-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/img/og/card.jpg"]
  }
}
